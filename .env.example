# Copy this file to .env in the repository root. Never commit real values.
# start-backend.ps1 and a direct backend/mvnw spring-boot:run load that local file.
DB_URL=jdbc:mysql://localhost:3306/lankastay_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lankastay_db
DB_USER=replace-with-database-user
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-local-secret
JPA_DDL_AUTO=update
# Development/demo only: also requires SPRING_PROFILES_ACTIVE=dev (never prod/production).
# Creates a completed reservation for the first active customer. Keep false normally.
LANKASTAY_DEMO_SEED_COMPLETED_RESERVATION=false
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
SESSION_COOKIE_SECURE=false

# Production Mail Provider Placeholders (Optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@lankastay.local
MAIL_PASSWORD=replace-with-local-secret

# Development bootstrap only. Remove these after the initial manager has been created.
INITIAL_MANAGER_EMAIL=manager@lankastay.com
INITIAL_MANAGER_PASSWORD=replace-with-strong-bootstrap-password
FRONTEND_URL=http://localhost:5174
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
